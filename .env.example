# Agent Search Console environment

# Optional. If unset, analysis uses deterministic heuristics only.
AI_API_KEY=
OPENAI_API_KEY=

# Optional model override for OpenAI-compatible chat completions.
AI_MODEL=gpt-4o-mini

# Optional. Production only. Analyses per IP per hour. Default 60. Ignored in development.
ANALYZE_RATE_LIMIT=60
